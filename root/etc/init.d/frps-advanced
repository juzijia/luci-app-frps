#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME="frps-advanced"
FRP_NAME="frps"
DEFAULT_CLIENT_FILE="/usr/bin/frps"
CONFIG_FOLDER="/var/etc/$NAME"

EXTRA_COMMANDS="preview_config"
EXTRA_HELP="\n\tpreview_config\tGenerate TOML from the current saved UCI without changing service state"

_log() {
	local level="$1"
	shift
	logger -p "daemon.$level" -t "$NAME" "$*"
	echo "[$level] $*" >&2
}

_info() {
	logger -p "daemon.info" -t "$NAME" "$*"
}

_err() {
	_log err "$@"
}

toml_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

append_string_array() {
	local file="$1"
	local key="$2"
	local value="$3"
	local item output old_ifs

	output=""
	old_ifs="$IFS"
	IFS=', '
	for item in $value; do
		[ -n "$item" ] || continue
		[ -n "$output" ] && output="$output, "
		output="${output}\"$(toml_escape "$item")\""
	done
	IFS="$old_ifs"
	printf '%s = [%s]\n' "$key" "$output" >>"$file"
}

append_port_ranges() {
	local file="$1"
	local key="$2"
	local value="$3"
	local item start end output old_ifs

	case "$value" in
		*'{'*)
			printf '%s = [ %s ]\n' "$key" "$value" >>"$file"
			return 0
			;;
	esac

	output=""
	old_ifs="$IFS"
	IFS=', '
	for item in $value; do
		[ -n "$item" ] || continue
		case "$item" in
			*-*)
				start="${item%-*}"
				end="${item#*-}"
				case "$start:$end" in
					*[!0-9:]*|:*|*:) IFS="$old_ifs"; _err "Invalid port range: $item"; return 1 ;;
				esac
				if [ "$start" -lt 1 ] || [ "$end" -gt 65535 ] || [ "$start" -ge "$end" ]; then
					IFS="$old_ifs"
					_err "Invalid port range: $item"
					return 1
				fi
				item="{ start = $start, end = $end }"
				;;
			*)
				case "$item" in
					*[!0-9]*) IFS="$old_ifs"; _err "Invalid port: $item"; return 1 ;;
				esac
				if [ "$item" -lt 1 ] || [ "$item" -gt 65535 ]; then
					IFS="$old_ifs"
					_err "Invalid port: $item"
					return 1
				fi
				item="{ single = $item }"
				;;
		esac
		[ -n "$output" ] && output="$output, "
		output="$output$item"
	done
	IFS="$old_ifs"
	printf '%s = [%s]\n' "$key" "$output" >>"$file"
}

# Specifications use ..RAW for TOML numbers/booleans, ..ARR for string arrays,
# and ..PORTS for frp's array of port-range objects. Other values are escaped
# TOML strings.
append_options() {
	local file="$1"
	shift
	local spec key kind variable value

	for spec in "$@"; do
		key="$spec"
		kind="STRING"
		case "$spec" in
			*..RAW) key="${spec%..RAW}"; kind="RAW" ;;
			*..ARR) key="${spec%..ARR}"; kind="ARR" ;;
			*..PORTS) key="${spec%..PORTS}"; kind="PORTS" ;;
		esac

		variable="${key//./__}"
		eval "value=\${$variable}"
		[ -n "$value" ] || continue

		case "$kind" in
			RAW) printf '%s = %s\n' "$key" "$value" >>"$file" ;;
			ARR) append_string_array "$file" "$key" "$value" || return 1 ;;
			PORTS) append_port_ranges "$file" "$key" "$value" || return 1 ;;
			*) printf '%s = "%s"\n' "$key" "$(toml_escape "$value")" >>"$file" ;;
		esac
	done
}

append_raw_setting() {
	[ -n "$1" ] && printf '%s\n' "$1" >>"$2"
}

append_http_plugin_op() {
	local op="$1"
	case "$op" in
		Login|NewProxy|CloseProxy|Ping|NewWorkConn|NewUserConn) ;;
		*)
			_err "Invalid HTTP plugin operation: $op"
			HTTP_PLUGIN_ERROR=1
			return 1
			;;
	esac
	[ -n "$plugin_ops" ] && plugin_ops="$plugin_ops, "
	plugin_ops="${plugin_ops}\"$(toml_escape "$op")\""
}

append_http_plugin() {
	local plugin_section="$1"
	local file="$2"
	local name addr path tls_verify

	config_get name "$plugin_section" name
	config_get addr "$plugin_section" addr
	config_get path "$plugin_section" path
	config_get tls_verify "$plugin_section" tlsVerify false

	if [ -z "$name" ] || [ -z "$addr" ] || [ -z "$path" ]; then
		_err "HTTP plugin $plugin_section requires name, addr and path"
		HTTP_PLUGIN_ERROR=1
		return 1
	fi
	case "$tls_verify" in
		true|false) ;;
		*)
			_err "HTTP plugin $name has invalid tlsVerify value"
			HTTP_PLUGIN_ERROR=1
			return 1
			;;
	esac

	plugin_ops=""
	config_list_foreach "$plugin_section" ops append_http_plugin_op
	if [ "$HTTP_PLUGIN_ERROR" = "1" ] || [ -z "$plugin_ops" ]; then
		[ -n "$plugin_ops" ] || _err "HTTP plugin $name requires at least one operation"
		HTTP_PLUGIN_ERROR=1
		return 1
	fi

	printf '\n[[httpPlugins]]\n' >>"$file"
	printf 'name = "%s"\n' "$(toml_escape "$name")" >>"$file"
	printf 'addr = "%s"\n' "$(toml_escape "$addr")" >>"$file"
	printf 'path = "%s"\n' "$(toml_escape "$path")" >>"$file"
	printf 'ops = [%s]\n' "$plugin_ops" >>"$file"
	printf 'tlsVerify = %s\n' "$tls_verify" >>"$file"
}

frps_section_validate() {
	uci_validate_section "$NAME" frps "$1" \
		'enabled:bool:0' \
		"client_file:string:$DEFAULT_CLIENT_FILE" \
		'run_user:string' \
		'respawn:bool:1' \
		'log__level:or("trace", "debug", "info", "warn", "error"):info' \
		'bindAddr:string' \
		'bindPort:port' \
		'proxyBindAddr:string' \
		'kcpBindPort:port' \
		'quicBindPort:port' \
		'vhostHTTPPort:port' \
		'vhostHTTPTimeout:uinteger' \
		'vhostHTTPSPort:port' \
		'tcpmuxHTTPConnectPort:port' \
		'tcpmuxPassthrough:or("true", "false")' \
		'subDomainHost:host' \
		'custom404Page:file' \
		'auth__method:or("token", "oidc")' \
		'auth__additionalScopes:string' \
		'auth__token:string' \
		'auth__tokenSource__file__path:file' \
		'auth__oidc__issuer:string' \
		'auth__oidc__audience:string' \
		'auth__oidc__skipExpiryCheck:or("true", "false")' \
		'auth__oidc__skipIssuerCheck:or("true", "false")' \
		'transport__tcpMux:or("true", "false")' \
		'transport__tcpMuxKeepaliveInterval:uinteger' \
		'transport__tcpKeepalive:integer' \
		'transport__maxPoolCount:uinteger' \
		'transport__heartbeatTimeout:integer' \
		'transport__quic__keepalivePeriod:integer' \
		'transport__quic__maxIdleTimeout:integer' \
		'transport__quic__maxIncomingStreams:uinteger' \
		'maxPortsPerClient:uinteger' \
		'allowPorts:string' \
		'userConnTimeout:uinteger' \
		'udpPacketSize:uinteger' \
		'natholeAnalysisDataReserveHours:uinteger' \
		'detailedErrorsToClient:or("true", "false")' \
		'transport__tls__force:or("true", "false")' \
		'transport__tls__certFile:file' \
		'transport__tls__keyFile:file' \
		'transport__tls__trustedCaFile:file' \
		'transport__tls__serverName:string' \
		'webServer__addr:host' \
		'webServer__port:port' \
		'webServer__user:string' \
		'webServer__password:string' \
		'webServer__tls__certFile:file' \
		'webServer__tls__keyFile:file' \
		'webServer__tls__trustedCaFile:file' \
		'webServer__tls__serverName:string' \
		'webServer__assetsDir:string' \
		'webServer__pprofEnable:or("true", "false")' \
		'enablePrometheus:or("true", "false")' \
		'sshTunnelGateway__bindPort:port' \
		'sshTunnelGateway__privateKeyFile:file' \
		'sshTunnelGateway__autoGenPrivateKeyPath:string' \
		'sshTunnelGateway__authorizedKeysFile:file' \
		'extra_setting:list(string)'
}

client_file_check() {
	local file="$1"

	[ -f "$file" ] || return 1
	[ -x "$file" ] || return 1
	return 0
}

client_file_validate() {
	local file="$1"

	[ -f "$file" ] || return 1
	[ -x "$file" ] || chmod 0755 "$file" || return 1
	client_file_check "$file"
}

render_config_file() {
	local output_file="$1"
	local section_name="$2"
	local auth__token="$auth__token"
	local auth__tokenSource__type="$auth__tokenSource__type"
	local HTTP_PLUGIN_ERROR=0
	local plugin_ops=""

	: >"$output_file" || return 1

	if [ -n "$auth__tokenSource__file__path" ]; then
		auth__token=""
		auth__tokenSource__type="file"
	fi

	append_options "$output_file" \
		"bindAddr" "bindPort..RAW" "proxyBindAddr" "kcpBindPort..RAW" "quicBindPort..RAW" \
		"vhostHTTPPort..RAW" "vhostHTTPTimeout..RAW" "vhostHTTPSPort..RAW" \
		"tcpmuxHTTPConnectPort..RAW" "tcpmuxPassthrough..RAW" "subDomainHost" "custom404Page" \
		"auth.method" "auth.additionalScopes..ARR" "auth.token" "auth.tokenSource.type" \
		"auth.tokenSource.file.path" "auth.oidc.issuer" "auth.oidc.audience" \
		"auth.oidc.skipExpiryCheck..RAW" "auth.oidc.skipIssuerCheck..RAW" || return 1

	# Follow ImmortalWrt FRP 0.66.0: FRPS logs to console and procd/logd owns delivery.
	append_options "$output_file" "log.level" || return 1

	append_options "$output_file" \
		"transport.tcpMux..RAW" "transport.tcpMuxKeepaliveInterval..RAW" \
		"transport.tcpKeepalive..RAW" "transport.maxPoolCount..RAW" "transport.heartbeatTimeout..RAW" \
		"transport.quic.keepalivePeriod..RAW" "transport.quic.maxIdleTimeout..RAW" \
		"transport.quic.maxIncomingStreams..RAW" "maxPortsPerClient..RAW" "allowPorts..PORTS" \
		"userConnTimeout..RAW" "udpPacketSize..RAW" "natholeAnalysisDataReserveHours..RAW" \
		"detailedErrorsToClient..RAW" "transport.tls.force..RAW" "transport.tls.certFile" \
		"transport.tls.keyFile" "transport.tls.trustedCaFile" "transport.tls.serverName" \
		"webServer.addr" "webServer.port..RAW" "webServer.user" "webServer.password" \
		"webServer.tls.certFile" "webServer.tls.keyFile" "webServer.tls.trustedCaFile" \
		"webServer.tls.serverName" "webServer.assetsDir" \
		"webServer.pprofEnable..RAW" "enablePrometheus..RAW" \
		"sshTunnelGateway.bindPort..RAW" "sshTunnelGateway.privateKeyFile" \
		"sshTunnelGateway.autoGenPrivateKeyPath" "sshTunnelGateway.authorizedKeysFile" || return 1

	config_foreach append_http_plugin http_plugin "$output_file"
	[ "$HTTP_PLUGIN_ERROR" = "0" ] || return 1

	config_list_foreach "$section_name" extra_setting append_raw_setting "$output_file"
}

verify_config_file() {
	local config_file="$1"
	local verify_log="$2"
	local verify_output

	if ! "$client_file" verify -c "$config_file" >"$verify_log" 2>&1; then
		verify_output="$(tail -n 1 "$verify_log")"
		_err "Generated configuration is invalid: ${verify_output:-unknown error}"
		return 1
	fi

	return 0
}

create_config_file() (
	local config_file="$1"
	local section_name="$2"
	local tmp_file verify_log

	umask 077
	mkdir -p "$CONFIG_FOLDER" || exit 1
	tmp_file="$(mktemp "$CONFIG_FOLDER/.frps.${section_name}.XXXXXX")" || exit 1
	trap 'rm -f "$tmp_file" "$verify_log"' EXIT HUP INT TERM
	verify_log="$(mktemp /tmp/${NAME}-verify.XXXXXX)" || exit 1

	render_config_file "$tmp_file" "$section_name" || exit 1
	verify_config_file "$tmp_file" "$verify_log" || exit 1
	mv -f "$tmp_file" "$config_file" || exit 1

	rm -f "$verify_log"
	trap - EXIT HUP INT TERM
)

cleanup_preview_config() {
	[ -n "$PREVIEW_TMP_DIR" ] && rm -rf "$PREVIEW_TMP_DIR"
	PREVIEW_TMP_DIR=""
}

preview_config() {
	local section_name="main"
	local tmp_file rc

	umask 077
	config_load "$NAME" || return 1
	if ! frps_section_validate "$section_name"; then
		_err "UCI configuration validation failed for $section_name"
		return 1
	fi
	PREVIEW_TMP_DIR="$(mktemp -d /tmp/${NAME}-preview.XXXXXX)" || return 1
	trap cleanup_preview_config EXIT HUP INT TERM
	tmp_file="$PREVIEW_TMP_DIR/frps.toml"

	render_config_file "$tmp_file" "$section_name" || {
		cleanup_preview_config
		trap - EXIT HUP INT TERM
		return 1
	}

	cat "$tmp_file"
	rc=$?
	cleanup_preview_config
	trap - EXIT HUP INT TERM
	return "$rc"
}

# Verify-only path for a disabled instance on Save & Apply.
# Renders a private candidate and lets the FRPS Core check it exactly once.
# Never touches /var/etc/$NAME/frps.$section.toml and never changes service state.
verify_saved_config() {
	local section_name="$1"
	local tmp_dir tmp_file verify_log rc=0

	umask 077
	tmp_dir="$(mktemp -d /tmp/${NAME}-applyverify.XXXXXX)" || return 1
	tmp_file="$tmp_dir/frps.toml"
	verify_log="$tmp_dir/verify.log"

	render_config_file "$tmp_file" "$section_name" || rc=1
	if [ "$rc" -eq 0 ]; then
		verify_config_file "$tmp_file" "$verify_log" || rc=1
	fi

	rm -rf "$tmp_dir"
	return "$rc"
}

start_instance() {
	local section="$1"
	local config_file

	config_get_bool enabled "$section" enabled 0

	if [ "$enabled" != "1" ]; then
		_info "Instance $section is disabled"
		return 0
	fi
	if ! frps_section_validate "$section"; then
		_err "UCI configuration validation failed for $section"
		return 1
	fi
	if ! client_file_validate "$client_file"; then
		_err "frps executable is missing or invalid: $client_file"
		return 1
	fi

	config_file="$CONFIG_FOLDER/frps.$section.toml"

	if [ "${FRPS_APPLY_PREVERIFIED:-0}" = "1" ]; then
		[ -f "$config_file" ] || {
			_err "Pre-verified runtime configuration is missing: $config_file"
			return 1
		}
	else
		create_config_file "$config_file" "$section" || return 1
	fi

	procd_open_instance "$FRP_NAME.$section"
	procd_set_param command "$client_file" -c "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	[ "$respawn" = "1" ] && procd_set_param respawn 3600 5 5
	procd_set_param file "$client_file" "$config_file"
	[ -n "$run_user" ] && procd_set_param user "$run_user"

	local zonename tzfile
	zonename="$(uci -q get system.@system[0].zonename)"
	tzfile="/usr/share/zoneinfo/$zonename"
	if [ -n "$zonename" ] && [ -r "$tzfile" ]; then
		procd_set_param env TZ="$tzfile"
	fi

	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

start_service() {
	config_load "$NAME"
	config_foreach start_instance frps
}

reload_service() {
	local section_name="main"
	local enabled

	config_load "$NAME" || return 1
	if ! frps_section_validate "$section_name"; then
		_err "UCI configuration validation failed for $section_name"
		return 1
	fi

	config_get_bool enabled "$section_name" enabled 0

	if [ "$enabled" != "1" ]; then
		if ! client_file_validate "$client_file"; then
			start
			_info "configuration saved, Core unavailable, configuration was not Core-verified"
			return 0
		fi
		if ! verify_saved_config "$section_name"; then
			_err "Saved configuration failed FRPS Core verification; keeping the current runtime and service state"
			return 1
		fi
		start
		return 0
	fi

	if ! client_file_validate "$client_file"; then
		_info "configuration saved but not Core-verified/applied because FRPS Core is unavailable"
		return 0
	fi

	local config_file rc

	config_file="$CONFIG_FOLDER/frps.$section_name.toml"

	if ! create_config_file "$config_file" "$section_name"; then
		_err "Saved configuration failed FRPS Core verification; keeping the current runtime and service state"
		return 1
	fi

	FRPS_APPLY_PREVERIFIED=1
	start
	rc=$?
	FRPS_APPLY_PREVERIFIED=0

	return "$rc"
}
