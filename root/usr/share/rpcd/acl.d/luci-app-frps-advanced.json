{
	"luci-app-frps-advanced": {
		"description": "Grant access to LuCI app frps-advanced",
		"read": {
			"file": {
				"/etc/passwd": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"log": [ "read" ],
				"luci.frps-advanced": [ "validate_backup" ]
			}
		},
		"write": {
			"ubus": {
				"luci.frps-advanced": [ "restore_config", "get_version", "get_config_compare" ]
			},
			"uci": { "frps-advanced": [ "read", "write" ] }
		}
	}
}
